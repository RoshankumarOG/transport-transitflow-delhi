{
  "builds": [
    { "src": "landing.html", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "planner.js", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": "network/*.csv.gz" } }
  ],
  "routes": [
    { "src": "/", "dest": "/landing.html" },
    { "src": "/planner", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
